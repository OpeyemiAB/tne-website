rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Product image uploads: Public read access for customers, upload permission for authenticated admins
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default catch-all rule
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
